# ===== 数学建模数据分析自动化系统 配置模板 =====
# 1. 复制此文件为 .env.dev（公开配置）
# 2. 创建 .env.private 填入真实 API Key（私密，不会被提交到 Git）

# ----- 5 个 Agent 主模型配置（统一使用 DeepSeek V4 Pro）-----
PARSER_MODEL=deepseek-v4-pro
PARSER_BASE_URL=https://api.deepseek.com
PARSER_MAX_TOKENS=4096

MODELER_MODEL=deepseek-v4-pro
MODELER_BASE_URL=https://api.deepseek.com
MODELER_MAX_TOKENS=8192

CODER_MODEL=deepseek-v4-pro
CODER_BASE_URL=https://api.deepseek.com
CODER_MAX_TOKENS=8192

WRITER_MODEL=deepseek-v4-pro
WRITER_BASE_URL=https://api.deepseek.com
WRITER_MAX_TOKENS=16384

REVIEWER_MODEL=deepseek-v4-pro
REVIEWER_BASE_URL=https://api.deepseek.com
REVIEWER_MAX_TOKENS=4096

# ----- Evaluator -----
EVALUATOR_MODEL=deepseek-v4-pro
EVALUATOR_BASE_URL=https://api.deepseek.com

# ----- 识图模型（PDF 图片识别为文字，单独配置可换多模态模型）-----
VISION_MODEL=deepseek-v4-pro
VISION_BASE_URL=https://api.deepseek.com

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- RAG 知识库 -----
RAG_ENABLED=false
RAG_DB_PATH=data/chromadb
RAG_TOP_K=5
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ----- Human-in-Loop -----
HIL_ENABLED=true
HIL_TIMEOUT=300

# ----- 反馈重跑 -----
MAX_FEEDBACK_ROUNDS=2
EVALUATION_THRESHOLD=0.6
MAX_RETRIES=3
MAX_MODELER_RETRIES=3
